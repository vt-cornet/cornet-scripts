[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT

[RULES]
IN ACCEPT -source +approved-subnets -p udp -dport 53 # DNS - approved subnets only
IN ACCEPT -source +approved-subnets -p tcp -dport 53 # DNS - approved subnets only
IN ACCEPT -source +approved-subnets -p tcp -dport 22 # SSH - approved subnets only
IN ACCEPT -source +approved-subnets -p tcp -dport 5000 # DDNS API - approved subnets only
